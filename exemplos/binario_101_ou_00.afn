# Livre 2: binários que contêm "101" OU terminam em "00" (AFND-ε).
# O estado inicial s escolhe, com transições ε, qual das duas condições
# vai verificar (união de dois autômatos):
#   a0..a3  procura a subpalavra 101 (a3 aceita o resto)
#   b0..b2  adivinha onde começa o "00" final
#
# aceita: 101 0101 1010 100 00 11100 1011000
# rejeita: ε 0 1 10 110 1001 0110 111
alfabeto: 0 1
estados: s a0 a1 a2 a3 b0 b1 b2
inicial: s
finais: a3 b2
transicoes:
s & -> a0 b0
a0 0 1 -> a0
a0 1 -> a1
a1 0 -> a2
a2 1 -> a3
a3 0 1 -> a3
b0 0 1 -> b0
b0 0 -> b1
b1 0 -> b2
